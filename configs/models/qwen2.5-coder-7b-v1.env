# Model profile (shell syntax): one LLM a run can name with `model:` in its
# spec (configs/runs/). Immutable once a run uses it; make a -v2 to change it.
# Download its weights on coe-hpc1 with `make llm-fetch PROFILE=qwen2.5-coder-7b-v1`.

# llm_serve.sh starts: vllm (the pinned server in configs/llm/vllm.env) or fake.
LLM_SERVER=vllm

# Qwen2.5-Coder-7B-Instruct (Apache-2.0, 15.2 GB bf16), pinned to a Hub commit.
MODEL_ID=Qwen/Qwen2.5-Coder-7B-Instruct
MODEL_REVISION=c03e6d358207e414f1eca0bb1891e29f1db0e242
MODEL_DIR=Qwen2.5-Coder-7B-Instruct@c03e6d35

# Server settings. 16384 tokens covers OpenEvolve's prompt plus max_tokens
# 4096 on a 40 GB A100; 0.90 is just under vLLM's 0.92 default.
CONTEXT_TOKENS=16384
VLLM_SERVE_ARGS="--max-model-len ${CONTEXT_TOKENS} --gpu-memory-utilization 0.90"

# Request defaults the resolver writes into OpenEvolve's llm section.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=300
