# Model profile for tests: scripts/fake_llm_server.py instead of vLLM, so a run
# spec can go through the whole job on coe-hpc1 with no GPU. It answers every
# request with the program from the prompt, or with AFAR_LLM_FAKE_REPLY's file.
LLM_SERVER=fake

MODEL_ID=afar/fake-llm-server
MODEL_REVISION=scripts/fake_llm_server.py
MODEL_DIR=

CONTEXT_TOKENS=16384
VLLM_SERVE_ARGS=

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=300
