# The pinned vLLM server (shell syntax), shared by every model profile in
# configs/models/. `make llm-fetch` downloads it on coe-hpc1 into $AFAR_ASSETS;
# compute nodes are offline and only read it. See docs/llm-serving.md.

# vLLM v0.30.0 (2026-09-22), x86_64 build on CUDA 13.0.2, pinned by digest.
# The A100 nodes' driver (590.44.01) supports CUDA 13.1.
VLLM_IMAGE=docker://vllm/vllm-openai@sha256:5f5e535216848d0c52159c8c13a0af04be5f6fe1a84e79914300610796f76d40
VLLM_SIF=vllm-openai_v0.30.0-x86_64.sif
# Unpacked on coe-hpc1, packed into VLLM_SIF on HPC3 (slurm/build_sif.sbatch), then deleted.
VLLM_SANDBOX=vllm-openai_v0.30.0-x86_64.sandbox
# Recorded when the SIF was built (job 91230, 2026-10-16); check with sha256sum.
VLLM_SIF_SHA256=40e8def6149a1d8924361f079ddf5a76b6ca8d53d518d550acc39a8e7f355584

# The name the server exposes, whatever model it serves; resolved OpenEvolve
# configs (controller/runspec.py) use it as the model name.
SERVED_MODEL_NAME=afar-llm
